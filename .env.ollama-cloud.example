# Load with: set -a; source .env.ollama-cloud.example; set +a
# No API key needed: the local Ollama service handles authentication.
STRIX_LLM=ollama/gemma4:31b-cloud
LLM_API_BASE=http://127.0.0.1:11434
LLM_EXTRA_BODY='{"think":false}'
STRIX_REASONING_EFFORT=none
STRIX_CONTEXT_FALLBACK_TOKENS=262144
STRIX_CONTEXT_BUFFER_TOKENS=20000
STRIX_CONTEXT_KEEP_TOKENS=8000
STRIX_CONTEXT_SUMMARY_TOKENS=4096
STRIX_TOOL_OUTPUT_MAX_TOKENS=8000
LLM_PREFLIGHT_TIMEOUT=180
LLM_STREAM_FIRST_EVENT_TIMEOUT=300
STRIX_TELEMETRY=false
STRIX_MAX_CONTEXT_IMAGES=3
